{
  "manifest_version": 3,
  "name": "ChatGPT Jump to Prompt",
  "version": "1.1.0",
  "description": "Quickly jump back to your own prompts in long ChatGPT conversations. Alt+J = last prompt, Alt+Up/Alt+Down = navigate between prompts.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Jump to Prompt"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["chatgpt-jump.user.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "jump-to-last-prompt": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Scroll to the most recent prompt in the current chat"
    },
    "jump-to-prev-prompt": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Alt+Up"
      },
      "description": "Jump to the previous prompt"
    },
    "jump-to-next-prompt": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Alt+Down"
      },
      "description": "Jump to the next prompt"
    }
  }
}
